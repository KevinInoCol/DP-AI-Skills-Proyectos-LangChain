# ============================================================
# Agente Municipal - variables de entorno
#   cp .env.example .env   y rellena los valores. Nunca subas .env.
# ============================================================

# OpenAI: modelo de chat (gpt-4.1) y embeddings del RAG
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXX

# Tavily: búsqueda en internet (https://app.tavily.com)
TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXX

# Postgres (Supabase): memoria, log de conversación y vector store
# Supabase → Connect → Session pooler (puerto 5432)
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_password
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Colección del vector store (convención tenant_id_<nombre>)
VECTOR_COLLECTION=tenant_id_municipio_girardota

# Identidad del agente
BOT_NAME=Giri
MUNICIPIO=Alcaldía de Girardota
AGENT_TIMEZONE=America/Bogota
